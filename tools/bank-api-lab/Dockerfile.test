FROM python:3.12-slim@sha256:9e01bf1ae5db7649a236da7be1e94ffbbbdd7a93f867dd0d8d5720d9e1f89fab

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace

# No copiar configuración, claves ni muestras operativas a la imagen de pruebas.
COPY requirements.txt requirements.lock requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt -c requirements.lock

CMD ["pytest", "-q", "-p", "no:cacheprovider"]
