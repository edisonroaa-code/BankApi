# Raíz de producción informada por Banco Atlas + familia de API. El adaptador
# agrega luego el path oficial (/cuentas/..., /sipap/..., /documentos, etc.).
ATLAS_BASE_URL=https://secure.atlas.com.py/api2-n/cuentas-atlas
ATLAS_TRANSFERENCIAS_BASE_URL=https://secure.atlas.com.py/api2-n/transferencias-atlas
ATLAS_DATOS_GENERALES_BASE_URL=https://secure.atlas.com.py/api2-n/datos-generales-atlas

ATLAS_API_KEY=colocar_api_key_del_banco
ATLAS_ACCOUNT_AUTH_TOKEN=colocar_token_de_autorizacion_de_cuenta

# Use one of these two options for the RSA private key.
# Política 2026 (los 4 manuales): la clave debe ser RSA de 4096 bits.
ATLAS_PRIVATE_KEY_PATH=./keys/atlas_private_key.pem
# ATLAS_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Offset de los rangos de fecha de negocio (fecInicio/fecFin), en hora local de
# Paraguay como en los ejemplos de los manuales.
# NOTA: no aplica a X-Atl-Timestamp, que siempre se envía en UTC (+00:00) porque
# los manuales lo definen "en UTC" y todos sus ejemplos vigentes lo usan así.
ATLAS_TIMESTAMP_OFFSET=-03:00
ATLAS_TIMEOUT_SECONDS=30
ATLAS_VERIFY_SSL=true

# --- Política 2026: claims JWT obligatorios (iss/sub/aud/exp/jti/iat) ---
# iss/sub identifican a esta aplicación ante Atlas (dato provisto por el banco).
ATLAS_JWT_ISS=colocar_issuer_provisto_por_atlas
ATLAS_JWT_SUB=colocar_subject_provisto_por_atlas
# Vigencia del JWT en segundos (exp = iat + este valor).
ATLAS_JWT_EXP_SECONDS=60

# Claim `user` (ACL). La tabla del manual v1.1 lo marca como opcional, pero el
# banco lo incluye en TODOS sus ejemplos vigentes: confirmar con Atlas si el ACL
# asignado lo exige antes de dejarlo sin configurar.
# ATLAS_JWT_USER=usuario_acl

# --- BLOQUEANTE-01: Verificación de respuesta del banco ---
# Clave pública del banco para verificar X-Atl-Auth en respuestas.
# Solicitar a Atlas y configurar antes de activar verify_response.
# ATLAS_BANK_PUBLIC_KEY_PATH=./keys/atlas_bank_public.pem
# ATLAS_BANK_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Producción: true. Use false sólo temporalmente en una vista de preproducción.
ATLAS_VERIFY_RESPONSE=true

# --- BLOQUEANTE-03: Autenticación interna ---
# Si se configura, todos los endpoints (excepto /, health, ready) requieren
# la cabecera X-Internal-ApiKey con este valor.
# OBLIGATORIA para registrar transferencias SIPAP: sin ella, el endpoint
# POST /api/transferencias/sipap/registrar-operacion responde 503.
# INTERNAL_API_KEY=generar_una_clave_segura_aqui
