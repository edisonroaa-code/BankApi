{
  "name": "bankapi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n FRONT,BACK -c cyan,blue \"vite\" \"cd backend && npm run start:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:health": "node --test services/health-readiness.test.cjs",
    "test:formularios:browser": "node scripts/formularios-browser/run.cjs",
    "test:matching:browser": "npm --prefix backend run build:prod && node scripts/matching-browser.cjs",
    "test:pwa": "node --test services/pwa-update.test.cjs services/pwa-two-tab.test.cjs",
    "test:manual-policy": "node --test services/manual-approval-policy.test.cjs services/payment-destination.test.cjs services/receipt-registration.test.cjs services/api-base-policy.test.cjs services/bank-claim-policy.test.cjs services/collector-refresh.test.cjs services/pwa-update.test.cjs services/my-bank-claims.test.cjs services/bank-refresh.test.cjs services/bank-panel-demand.test.cjs services/audit-format.test.cjs services/bank-month.test.cjs services/print-sync.test.cjs services/review-queue.test.cjs services/consulta-draft.test.cjs scripts/with-atlas-lab-env.test.cjs",
    "test:secrets": "node --test backend/scripts/migrate-images-to-cloudinary.source.spec.cjs",
    "typecheck": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --host 0.0.0.0 --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:server": "electron electron/server_tray.cjs",
    "backend:build:prod": "npm --prefix backend run build:prod",
    "backend:docker:build": "docker build --file backend/Dockerfile --target production --tag bankapi-backend:prod backend",
    "desktop:pre:client": "node scripts/clean-dir.cjs dist && node scripts/clean-dir.cjs release && node scripts/clean-dir.cjs release-build",
    "desktop:pre:base": "npm run desktop:pre:client && node scripts/clean-dir.cjs .packaging && npm run backend:build:prod && node scripts/prepare-backend-package.cjs",
    "desktop:pre:simple": "npm run desktop:pre:base",
    "desktop:pre:full": "npm run desktop:pre:base && npm run backend:docker:build",
    "desktop:pre:skip-docker": "npm run desktop:pre:simple",
    "desktop:pre:with-docker": "npm run desktop:pre:full",
    "build:desktop:app": "node --max-old-space-size=6144 node_modules/vite/bin/vite.js build --mode electron --minify true",
    "build:desktop:installer": "node scripts/build-installer-flavor.cjs client",
    "build:desktop:installer:client": "node scripts/build-installer-flavor.cjs client",
    "build:desktop:installer:server": "node scripts/build-installer-flavor.cjs server",
    "desktop:post": "node scripts/postbuild-desktop.cjs",
    "build:desktop:client": "npm run desktop:pre:client && npm run build:desktop:app && npm run build:desktop:installer:client",
    "build:desktop:server": "npm run desktop:pre:simple && npm run build:desktop:app && npm run build:desktop:installer:server && npm run desktop:post",
    "build:desktop:simple": "npm run build:desktop:client",
    "build:desktop:full": "npm run desktop:pre:full && npm run build:desktop:app && npm run build:desktop:installer:client && npm run build:desktop:installer:server && npm run desktop:post",
    "build:desktop": "npm run build:desktop:full",
    "electron:pack": "npm run desktop:pre:simple && npm run build:desktop:app && electron-builder --dir --publish never",
    "electron:build": "npm run build:desktop"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.561.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.bankapi.desktop",
    "productName": "BankApi",
    "compression": "normal",
    "asar": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419",
      "pt-BR"
    ],
    "icon": "resources/icon.png",
    "extraResources": [
      {
        "from": ".packaging/backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "public/**/*",
          "package.json",
          ".env",
          "docker-compose.yml",
          "node_modules/**/*",
          "!src/**",
          "!test/**",
          "!tests/**",
          "!uploads/**",
          "!logs/**",
          "!dist/**/*.map",
          "!dist/**/*.d.ts",
          "!dist/**/*.tsbuildinfo",
          "!node_modules/.bin",
          "!node_modules/.bin/**",
          "!node_modules/**/*.md",
          "!node_modules/**/*.markdown",
          "!node_modules/**/*.txt",
          "!node_modules/**/*.ts",
          "!node_modules/**/*.d.ts",
          "!node_modules/**/*.map",
          "!node_modules/@types/**",
          "!node_modules/typescript/**",
          "!node_modules/ts-node/**",
          "!node_modules/**/LICENSE*",
          "!node_modules/**/CHANGELOG*",
          "!node_modules/**/HISTORY*",
          "!node_modules/**/README*",
          "!node_modules/**/readme*",
          "!node_modules/**/Makefile",
          "!node_modules/**/Gulpfile*",
          "!node_modules/**/Gruntfile*",
          "!node_modules/**/test/**",
          "!node_modules/**/tests/**",
          "!node_modules/**/__tests__/**",
          "!node_modules/**/spec/**",
          "!node_modules/**/specs/**",
          "!node_modules/**/example/**",
          "!node_modules/**/examples/**",
          "!node_modules/**/docs/**",
          "!node_modules/**/.github/**",
          "!node_modules/**/.vscode/**",
          "!node_modules/**/.idea/**",
          "!node_modules/**/*.d.ts.map"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [],
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "electron/**/*.js",
      "resources/icon.png",
      "resources/splash.png",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!src{,/**}",
      "!test{,/**}",
      "!tests{,/**}",
      "!backups{,/**}",
      "!logs{,/**}",
      "!uploads{,/**}",
      "!backend{,/**}",
      "!release{,/**}",
      "!release-build{,/**}",
      "!_backup_optimization{,/**}",
      "!.github{,/**}",
      "!.vscode{,/**}",
      "!.idea{,/**}"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "BankApi Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/nsis-include.nsh"
    }
  }
}
