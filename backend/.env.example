# API
PORT=3000
NODE_ENV=production
JWT_SECRET=change_this_secret_before_exposing_outside_trusted_lan

# Database from host Windows/local dev
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=transferencias_db
DB_SYNCHRONIZE=false

# Origenes del navegador permitidos (coma). Vacio = cualquier origen (historico).
# Electron cargado desde file:// envia Origin "null": agregar null si se usa.
# CORS_ORIGINS=https://bankapi-web.onrender.com
# COMPANY_NAME=BankApi

# --- Feed de transferencias del banco (Atlas Connect, solo lectura) ---
# off: apagado | mock: transferencias simuladas (solo desarrollo, prohibido en produccion) | atlas: banco real
BANK_FEED_MODE=off
# BANK_FEED_ACCOUNT=1870227
# BANK_FEED_HOURS=07:00-20:00
# BANK_FEED_INTERVAL_SECONDS=5
# Al abrir el primer panel del dia trae lo que entro sin nadie mirando (noche, fin de semana),
# desde el ultimo movimiento registrado y como mucho N dias atras. 0 lo apaga; maximo 10.
# BANK_FEED_CATCHUP_DAYS=4
# Banco de origen via Consulta de Operaciones SIPAP: validar con datos reales antes de activar.
# BANK_FEED_SIPAP_ENRICH=false
# BANK_FEED_OWN_SWIFT=
# Credenciales: las mismas del laboratorio (tools/bank-api-lab). Nunca en el repositorio.
# Produccion (api2-n). Sandbox: https://secure7.atlas.com.py/desa03/...
# ATLAS_BASE_URL=https://secure.atlas.com.py/api2-n/cuentas-atlas
# ATLAS_TRANSFERENCIAS_BASE_URL=https://secure.atlas.com.py/api2-n/transferencias-atlas
# ATLAS_DATOS_GENERALES_BASE_URL=https://secure.atlas.com.py/api2-n/datos-generales-atlas
# ATLAS_API_KEY=
# ATLAS_ACCOUNT_AUTH_TOKEN=
# ATLAS_PRIVATE_KEY_PEM=  (o ATLAS_PRIVATE_KEY_PATH en desarrollo)
# ATLAS_JWT_ISS=
# ATLAS_JWT_SUB=
# ATLAS_BANK_PUBLIC_KEY_PEM=  (o ATLAS_BANK_PUBLIC_KEY_PATH)
# ATLAS_VERIFY_RESPONSE=true   (es el valor por defecto; solo `false` explícito la apaga, para sandbox/preproducción)

# Database from Docker compose internal network
# DB_HOST=db
# DB_PORT=5432
